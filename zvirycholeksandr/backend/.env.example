PORT=1995
NODE_ENV=production
SITE_URL=https://zvirycholeksandr.com.ua
SITE_HEALTH_URL=https://zvirycholeksandr.com.ua/api/health

# Дані та резервні копії (за замовчуванням — директорії всередині проєкту)
DATA_DIR=/var/lib/zvirycholeksandr/data
BACKUP_DIR=/var/backups/zvirycholeksandr
KEEP_DAYS=30

# JWT для адмінки (мінімум 64 символи, будь-який рандомний рядок)
JWT_SECRET=

# Telegram — повідомлення про нові замовлення і помилки
TELEGRAM_BOT_TOKEN=123456789:ABCdef...
TELEGRAM_CHAT_ID=123456789

# Email (Gmail SMTP) — підтвердження замовлень і лист з готовою роботою
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=oleksandrzvirich@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=Олександр Звірич <oleksandrzvirich@gmail.com>
